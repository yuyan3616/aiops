LOG_LEVEL=info
PI_CHAT_HOST=127.0.0.1
PI_CHAT_PORT=4328
RCA_INVESTIGATIONS_DIR=/absolute/path/to/pi-chat-rca-investigations

# Live Observability endpoints. Do not embed credentials in these URLs.
# NGINX prefixes are supported, e.g. https://observe.example.com/tempo/
# See docs/live-gateway-connection.md for path stripping and auth.
TEMPO_BASE_URL=https://tempo.example.internal
LOKI_BASE_URL=https://loki.example.internal
PROMETHEUS_BASE_URL=https://prometheus.example.internal

# Optional server-side auth. Never expose these values to the Agent.
TEMPO_BEARER_TOKEN=
LOKI_BEARER_TOKEN=
PROMETHEUS_BEARER_TOKEN=
TEMPO_BASIC_USERNAME=
TEMPO_BASIC_PASSWORD=
LOKI_BASIC_USERNAME=
LOKI_BASIC_PASSWORD=
PROMETHEUS_BASIC_USERNAME=
PROMETHEUS_BASIC_PASSWORD=
TEMPO_TENANT_ID=
LOKI_TENANT_ID=
PROMETHEUS_TENANT_ID=

# Backend label mapping for Loki / Prometheus.
LOKI_SERVICE_LABEL=service_name
LOKI_ENVIRONMENT_LABEL=environment
LOKI_CONTAINER_LABEL=container
PROMETHEUS_SERVICE_LABEL=service
PROMETHEUS_ENVIRONMENT_LABEL=environment
PROMETHEUS_CONTAINER_LABEL=container

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development

# 可选：私有 Agent 配置仓库；凭据仅允许此仓库 Contents Read-only
# 不配置仓库时使用应用随版快照
AGENT_CONFIG_REPOSITORY=
AGENT_CONFIG_REF=main
AGENT_CONFIG_GITHUB_TOKEN=
