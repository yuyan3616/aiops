# Pi ModelRuntime reads provider keys from environment variables.
# Configure at least one provider.
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# Optional: pin one Pi model. Leave both unset for automatic model selection.
# RCA_MODEL_PROVIDER=openai
# RCA_MODEL_ID=<model-id-registered-in-pi>

PI_CHAT_HOST=127.0.0.1
PI_CHAT_PORT=4328

# v7 intentionally keeps observability sources fake.
# Loki / Prometheus / Tempo / deployment credentials are NOT required yet.
