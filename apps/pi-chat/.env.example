LOG_LEVEL=info
PI_CHAT_HOST=127.0.0.1
PI_CHAT_PORT=4328
RCA100_CASES_DIR=/absolute/path/to/agenticopseval/RCA100/cases
RCA_INVESTIGATIONS_DIR=/absolute/path/to/pi-chat-rca-investigations
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional OpenTelemetry signals. Shared endpoint expands to /v1/traces and /v1/metrics.
OTEL_SERVICE_NAME=aiops-rca-target
# OTEL_SERVICE_INSTANCE_ID=target-replica-1  # defaults to container HOSTNAME when available
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_METRIC_EXPORT_TIMEOUT_MS=5000

# Metric labels are allowlist-only. Unknown values collapse to "other".
# Keep these lists small: provider <= 8, model <= 32, tool <= 64.
# OTEL_METRIC_PROVIDER_ALLOWLIST=packyapi,openai,anthropic
# OTEL_METRIC_MODEL_ALLOWLIST=claude-sonnet-4-5,gpt-5
# OTEL_METRIC_TOOL_ALLOWLIST=read,write,edit,bash

# Graceful process shutdown deadline for in-flight Pi sessions and telemetry.
PI_CHAT_SHUTDOWN_TIMEOUT_MS=10000
