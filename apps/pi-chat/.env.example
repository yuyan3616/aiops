# Pi ModelRuntime reads provider keys from environment variables.
# Configure at least one provider.
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# Optional: pin one Pi model. Leave both unset for automatic model selection.
# RCA_MODEL_PROVIDER=openai
# RCA_MODEL_ID=<model-id-registered-in-pi>

PI_CHAT_HOST=127.0.0.1
PI_CHAT_PORT=4328

# RCA100 dataset settings. The public t039 case is downloaded on first run by default.
RCA100_AUTO_DOWNLOAD=true
# RCA100_DATA_DIR=/absolute/path/to/rca100
# RCA100_BASE_URL=https://aiops-benchmark.oss-cn-hongkong.aliyuncs.com/rca/rca100/v1.1

# v8.1 Harness policy overrides (optional; defaults shown).
# RCA_TASK_TIMEOUT_MS=60000
# RCA_TASK_MAX_TURNS=6
# RCA_TASK_MAX_TOOL_CALLS=10
# RCA_TASK_MAX_EVIDENCE=12
# RCA_TASK_GLOBAL_CONCURRENCY=3

# No Loki / Prometheus / Tempo credentials are required for the RCA100 demo.
# Ground truth / answer_key is deliberately not downloaded into the Agent runtime.
